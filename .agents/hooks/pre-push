#!/bin/sh
# ----------------------------------------------------------------------
# PanelForge Protected Branch Git Hook (pre-push)
# Blocks direct and accidental pushes to protected branches: dev, stg, main
# ----------------------------------------------------------------------

REMOTE="$1"
URL="$2"

ZERO_SHA="0000000000000000000000000000000000000000"

while read LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA
do
    # Extract branch name from refs/heads/<branch>
    BRANCH_NAME="${REMOTE_REF#refs/heads/}"

    # Process branch rules
    case "$BRANCH_NAME" in
        dev)
            # 1. Prevent branch deletion
            if [ "$LOCAL_SHA" = "$ZERO_SHA" ]; then
                echo "❌ [PanelForge Git Guard] CẢNH BÁO: TUYỆT ĐỐI CẤM XOÁ NHÁNH TÍCH HỢP 'dev'!" >&2
                exit 1
            fi
            # 2. Allow direct push to dev without Pull Request
            echo "ℹ️  [PanelForge Git Guard] Cho phép thành viên merge & push trực tiếp vào nhánh 'dev' (không bắt buộc Pull Request)." >&2
            continue
            ;;
        main|master|stg)
            # 1. Prevent branch deletion
            if [ "$LOCAL_SHA" = "$ZERO_SHA" ]; then
                echo "❌ [PanelForge Git Guard] CẢNH BÁO: TUYỆT ĐỐI CẤM XOÁ NHÁNH PROTECTED '$BRANCH_NAME'!" >&2
                exit 1
            fi

            # 2. Check if explicit promotion bypass is enabled
            if [ "$PANELFORGE_ALLOW_PROTECTED_PUSH" = "1" ] || [ "$PANELFORGE_ALLOW_PROMOTION" = "1" ]; then
                # Allowed by authorized promotion script or Lead bypass
                echo "🛡️  [PanelForge Git Guard] Xác nhận biến PANELFORGE_ALLOW_PROTECTED_PUSH=1: Cho phép cập nhật nhánh '$BRANCH_NAME'." >&2
                continue
            fi

            # 3. Block unauthorized direct push
            echo "" >&2
            echo "❌ [PanelForge Git Guard] LỆNH PUSH BỊ CHẶN: KHÔNG THỂ PUSH TRỰC TIẾP LÊN '$BRANCH_NAME'!" >&2
            echo "==========================================================================================" >&2
            echo "  Dự án PanelForge áp dụng quy chuẩn bảo vệ nhánh nghiêm ngặt (Protected Branch Policy):" >&2
            echo "    - 'stg'  : Staging môi trường kiểm thử, chỉ nhận promote từ 'dev' sau khi đóng Sprint." >&2
            echo "    - 'main' : Production chính thức, chỉ nhận promote từ 'stg' sau nghiệm thu UAT." >&2
            echo "" >&2
            echo "  👉 NẾU BẠN LÀ AI AGENT HOẶC DEV:" >&2
            echo "     Hãy merge vào 'dev' trước. Chỉ promote sang 'stg'/'main' khi có yêu cầu chính thức." >&2
            echo "" >&2
            echo "  👉 NẾU BẠN LÀ LEAD / DEV CẦN PROMOTE HỢP LỆ:" >&2
            echo "     1. Sử dụng script tự động có kiểm định:" >&2
            echo "        powershell -File panelforge-hub/.agents/scripts/promote_branch.ps1 -From dev -To stg -Push" >&2
            echo "     2. Hoặc mở khóa bằng biến môi trường (chỉ dùng khi khẩn cấp):" >&2
            echo "        Windows PowerShell: \$env:PANELFORGE_ALLOW_PROTECTED_PUSH=\"1\"; git push $REMOTE $BRANCH_NAME" >&2
            echo "        Bash/Linux/Mac    : PANELFORGE_ALLOW_PROTECTED_PUSH=1 git push $REMOTE $BRANCH_NAME" >&2
            echo "==========================================================================================" >&2
            echo "" >&2
            exit 1
            ;;
    esac
done

exit 0
